{
  "fin-buddy-preflight": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=\"./tools/agent-hooks/preflight.sh\"; [ -f \"$f\" ] || f=\"/home/faran/Workspace/fin-buddy/tools/agent-hooks/preflight.sh\"; exec \"$f\" --antigravity'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "fin-buddy-post-task": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=\"./tools/agent-hooks/post-task.sh\"; [ -f \"$f\" ] || f=\"/home/faran/Workspace/fin-buddy/tools/agent-hooks/post-task.sh\"; exec \"$f\" --antigravity'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
