# =============================================================================
# Fin Buddy — Docker Compose environment (optional root overrides)
#
# Secrets can live in EITHER place:
#   1. backend/.env   ← already used for local `uv run uvicorn` (recommended)
#   2. root .env      ← this file:  cp .env.example .env
#
# Compose loads backend/.env then root .env into the API container.
# You do NOT need a root .env if backend/.env already has DATABASE_URL + Supabase.
# =============================================================================

# Image tag applied to both services
IMAGE_TAG=latest

# Host ports
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000

# Public frontend URL. Browser API requests go through the same-origin BFF.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Leave CORS blank in the deployed BFF topology. Local direct API use can opt in.
CORS_ORIGINS=

# Server-only URL used by the Next.js BFF (Docker service name locally).
BACKEND_INTERNAL_URL=http://backend:8000

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=Fin Buddy API

# Run Alembic once on container start (recommended with WEB_CONCURRENCY > 1)
RUN_MIGRATIONS=true
AUTO_SEED=false
DEMO_AUTH_ENABLED=false
TRUSTED_PROXY_IPS=

# Required before a trusted scheduler can trigger reminder emails.
# JOB_RUNNER_SECRET=

WEB_CONCURRENCY=2

# Comma-separated emails elevated to super_admin on first login
PLATFORM_ADMIN_EMAILS=you@example.com

LOG_API_REQUESTS=true
LOG_REQUEST_BODY=false
OPERATIONAL_LOG_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
# Prefer pooler URI (Session or Transaction mode)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional override; default is {SUPABASE_URL}/auth/v1
# SUPABASE_JWT_ISSUER=

# Statement storage: use supabase for FastAPI Cloud
STATEMENT_STORAGE_BACKEND=local
STATEMENT_STORAGE_DIR=/data/statements
STATEMENT_STORAGE_BUCKET=statements

# -----------------------------------------------------------------------------
# Optional resource limits (Compose deploy.resources; honored by Swarm / some runtimes)
# -----------------------------------------------------------------------------
# BACKEND_CPU_LIMIT=2.0
# BACKEND_MEMORY_LIMIT=512M
# FRONTEND_CPU_LIMIT=1.5
# FRONTEND_MEMORY_LIMIT=512M
