# =============================================================================
# Fin Buddy API — copy to backend/.env and fill values from Supabase dashboard
# =============================================================================

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=Fin Buddy API

# Comma-separated browser origins allowed for CORS (plain string, not JSON)
# Include every port you open the UI on (Next may use 3001 if 3000 is taken).
# In development, localhost:any-port is also allowed via regex in main.py.
# Examples:
#   CORS_ORIGINS=http://localhost:3000,http://localhost:3001
#   CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Auto-run Alembic migrations + seeders on server start
AUTO_MIGRATE=true
AUTO_SEED=true

# Emails elevated to super_admin on first login (comma-separated)
PLATFORM_ADMIN_EMAILS=you@example.com

# Request logging into api_request_logs
LOG_API_REQUESTS=true
LOG_REQUEST_BODY=false

# -----------------------------------------------------------------------------
# Database — Supabase Project Settings → Database → Connection string
# -----------------------------------------------------------------------------
# Prefer the **pooler** URI (Session or Transaction). Many networks cannot resolve
# the direct host db.[PROJECT-REF].supabase.co (DNS "nodename nor servname").
#
# Dashboard path:
#   Project Settings → Database → Connection string → URI
#   Method: "Session mode" (port 5432) or "Transaction" (port 6543)
#
# Pooler examples (username is often postgres.[PROJECT-REF], NOT just postgres):
#   postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#   postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
# Avoid unless it resolves on your machine:
#   postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Special password chars (@ # : / ? %) must be URL-encoded.
# Do NOT wrap the whole URL in quotes unless necessary.
DATABASE_URL=
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Supabase Auth — Project Settings → API
# -----------------------------------------------------------------------------
# Project URL (e.g. https://xxxxxxxx.supabase.co)
SUPABASE_URL=

# anon / public key (safe for frontend; backend uses it for Auth REST with user context)
SUPABASE_ANON_KEY=

# service_role key (SECRET — backend only, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# JWT Secret (Project Settings → API → JWT Settings → JWT Secret)
# Used by the API to verify access tokens (HS256)
SUPABASE_JWT_SECRET=

# Usually leave default:
SUPABASE_JWT_AUDIENCE=authenticated

# Optional override; default is {SUPABASE_URL}/auth/v1
# SUPABASE_JWT_ISSUER=https://xxxxxxxx.supabase.co/auth/v1

# Public frontend URL (email confirmation + magic-link redirects)
# FRONTEND_APP_URL=https://fin-buddy-dev.vercel.app

# -----------------------------------------------------------------------------
# Statement file storage
# -----------------------------------------------------------------------------
# local     — filesystem under STATEMENT_STORAGE_DIR (dev / docker volume)
# supabase  — private bucket via Storage API (use for FastAPI Cloud / multi-instance)
STATEMENT_STORAGE_BACKEND=local
STATEMENT_STORAGE_DIR=storage/statements
STATEMENT_STORAGE_BUCKET=statements
# STATEMENT_MAX_UPLOAD_BYTES=15728640
