# =============================================================================
# Fin Buddy API — copy to backend/.env and fill values from Supabase dashboard
# =============================================================================

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=Fin Buddy API

# The deployed frontend uses its same-origin Next.js BFF, so leave this blank in
# production. For direct local API calls, set explicit localhost origins here.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Trust X-Forwarded-For only when requests arrive from these known proxy IPs.
# Leave empty for direct local/Docker access; never use *.
TRUSTED_PROXY_IPS=

# Auto-run Alembic migrations + seeders on server start
AUTO_MIGRATE=true
AUTO_SEED=true

# Emails elevated to super_admin on first login (comma-separated)
PLATFORM_ADMIN_EMAILS=you@example.com

# Request logging into api_request_logs
LOG_API_REQUESTS=true
LOG_REQUEST_BODY=false
# Automatically purge old API, activity, and error logs using existing Supabase Postgres.
OPERATIONAL_LOG_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Database — Supabase Project Settings → Database → Connection string
# -----------------------------------------------------------------------------
# Prefer the **pooler** URI (Session or Transaction). Many networks cannot resolve
# the direct host db.[PROJECT-REF].supabase.co (DNS "nodename nor servname").
#
# Dashboard path:
#   Project Settings → Database → Connection string → URI
#   Method: "Session mode" (port 5432) or "Transaction" (port 6543)
#
# Pooler examples (username is often postgres.[PROJECT-REF], NOT just postgres):
#   postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#   postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
# Avoid unless it resolves on your machine:
#   postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Special password chars (@ # : / ? %) must be URL-encoded.
# Do NOT wrap the whole URL in quotes unless necessary.
DATABASE_URL=
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Supabase Auth — Project Settings → API
# -----------------------------------------------------------------------------
# Project URL (e.g. https://xxxxxxxx.supabase.co)
SUPABASE_URL=

# Supabase client API key: modern sb_publishable_... key or legacy anon key
# Backend supports SUPABASE_PUBLISHABLE_KEY as primary, with SUPABASE_ANON_KEY as compatibility alias.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# service_role key (SECRET — backend only, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=

# JWT verification mode: "hybrid" (dev/test default) or "jwks_only" (required in production)
# In production, set JWT_VERIFICATION_MODE=jwks_only (verifies ES256 tokens via Supabase JWKS)
JWT_VERIFICATION_MODE=hybrid

# JWT Secret (Project Settings → API → JWT Settings → JWT Secret)
# Required only in hybrid/HS256 mode (local dev/test). Optional in production when JWT_VERIFICATION_MODE=jwks_only.
SUPABASE_JWT_SECRET=

# Usually leave default:
SUPABASE_JWT_AUDIENCE=authenticated

# Optional override; default is {SUPABASE_URL}/auth/v1
# SUPABASE_JWT_ISSUER=https://xxxxxxxx.supabase.co/auth/v1

# Public frontend URL (email confirmation + magic-link redirects)
FRONTEND_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Statement file storage
# -----------------------------------------------------------------------------
# local     — filesystem under STATEMENT_STORAGE_DIR (dev / docker volume)
# supabase  — private bucket via Storage API (use for FastAPI Cloud / multi-instance)
STATEMENT_STORAGE_BACKEND=local
STATEMENT_STORAGE_DIR=storage/statements
STATEMENT_STORAGE_BUCKET=statements
# The Supabase `statements` bucket is configured to the same hard ceiling.
STATEMENT_MAX_UPLOAD_BYTES=15728640
STATEMENT_UPLOAD_TTL_SECONDS=900
STATEMENT_ABANDON_AFTER_SECONDS=3600
# Parser budgets: rows, columns, sheets, PDF pages, ZIP bytes, lines, text chars.
STATEMENT_PARSER_MAX_ROWS=10000
STATEMENT_PARSER_MAX_COLUMNS=100
STATEMENT_PARSER_MAX_SHEETS=10
STATEMENT_PARSER_MAX_PDF_PAGES=50
STATEMENT_PARSER_MAX_DECOMPRESSED_BYTES=67108864
STATEMENT_PARSER_MAX_LINES=10000
STATEMENT_PARSER_MAX_TEXT_CHARS=1000000
STATEMENT_PARSE_TIMEOUT_SECONDS=20

# Resend API Key for email reminders
# RESEND_API_KEY=re_123456789

# Secret for your trusted scheduler to call POST /api/v1/jobs/send-reminders.
# Send it as X-Job-Secret. Keep it distinct from Supabase secrets.
# JOB_RUNNER_SECRET=
